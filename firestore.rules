rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-all Security Net
    match /{document=**} {
      allow read, write: if true;
    }

    match /jobs/{jobId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /conversations/{chatId} {
      allow read, write: if true;
    }

    match /staff_statuses/{uid} {
      allow read, write: if true;
    }

    match /connection_tests/{testId} {
      allow read, write: if true;
    }

    match /push_subscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    match /system_notifications/{notificationId} {
      allow read, write: if true;
    }

    match /daily_reports/{reportId} {
      allow read, write: if true;
    }

    match /daily_stats/{statId} {
      allow read, write: if true;
    }

    match /contacts/{contactId} {
      allow read, write: if true;
    }

    match /candidate_list_logs/{logId} {
      allow read, write: if true;
    }

    match /staff_resumptions/{resumptionId} {
      allow read, write: if true;
    }

    match /staff_report_reopens/{reopenId} {
      allow read, write: if true;
    }

    match /whatsapp_sessions/{sessionId} {
      allow read, write: if true;
    }
  }
}
