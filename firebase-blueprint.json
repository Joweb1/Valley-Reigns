{
  "entities": {
    "Job": {
      "title": "Job",
      "description": "Represents a job listing posted by staff or admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique job identifier." },
        "title": { "type": "string", "description": "Title of the job role." },
        "company": { "type": "string", "description": "Name of the hiring company." },
        "category": { "type": "string", "description": "Job category (e.g. Tech, Healthcare, Finance)." },
        "salary": { "type": "string", "description": "Salary range or compensation package." },
        "location": { "type": "string", "description": "Geographic location or Remote status." },
        "type": { "type": "string", "description": "Employment type (e.g. Full-time, Part-time, Contract)." },
        "requirements": { "type": "array", "description": "List of core job qualifications and requirements." },
        "description": { "type": "string", "description": "Detailed description of the job duties." },
        "impressions": { "type": "number", "description": "The count of views or interactions." },
        "createdAt": { "type": "number", "description": "Epoch timestamp when the listing was created." }
      },
      "required": ["id", "title", "company", "category", "salary", "location", "type", "description", "impressions", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a user profile with role-based dashboard permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Authentication UID." },
        "email": { "type": "string", "description": "User email address." },
        "displayName": { "type": "string", "description": "Public display name of the user." },
        "role": { "type": "string", "enum": ["seeker", "staff", "admin", "employer"], "description": "User clearance role defining routing and access permissions." },
        "canPostJobs": { "type": "boolean", "description": "Flag indicating if the user is authorized to post new listings." }
      },
      "required": ["uid", "email", "displayName", "role", "canPostJobs"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "In-app and WhatsApp messaging conversation backing store.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "Unique conversation ID." },
        "customerPhone": { "type": "string", "description": "Customer telephone number or identifier." },
        "status": { "type": "string", "enum": ["pending", "ongoing", "finished", "abandoned"], "description": "Current lifecycle status." },
        "assignedTo": { "type": "string", "description": "Assigned staff member UID." },
        "assignedToName": { "type": "string", "description": "Assigned staff member display name." },
        "sharedWith": { "type": "array", "description": "List of candidate staff UIDs routed to claim this conversation." },
        "text": { "type": "string", "description": "Latest conversation text summary." },
        "jobId": { "type": "string", "description": "Linked job vacancy ID." },
        "jobTitle": { "type": "string", "description": "Linked job vacancy title." },
        "createdAt": { "type": "number", "description": "Creation epoch timestamp." },
        "lastMessageAt": { "type": "number", "description": "Timestamp of most recent message." },
        "messages": { "type": "array", "description": "Ordered array of chat message entries." },
        "typing": { "type": "object", "description": "Real-time typing status map." },
        "isReported": { "type": "boolean", "description": "Whether conversation has been flagged." },
        "isInApp": { "type": "boolean", "description": "True if initiated via in-app portal." },
        "seekerUid": { "type": "string", "description": "Authenticated seeker UID if available." }
      },
      "required": ["chatId", "status", "createdAt", "lastMessageAt"]
    },
    "StaffStatus": {
      "title": "StaffStatus",
      "description": "Real-time presence and availability status for recruiter staff.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Staff user UID." },
        "status": { "type": "string", "enum": ["online", "offline"], "description": "Online presence state." },
        "lastActive": { "type": "number", "description": "Epoch timestamp of last activity heartbeat." },
        "email": { "type": "string", "description": "Staff email address." }
      },
      "required": ["uid", "status", "lastActive"]
    },
    "WhatsAppConfig": {
      "title": "WhatsAppConfig",
      "description": "WhatsApp Business API credentials and webhook verification details.",
      "type": "object",
      "properties": {
        "phoneNumberId": { "type": "string", "description": "WhatsApp Phone Number ID." },
        "businessAccountId": { "type": "string", "description": "WhatsApp Business Account ID." },
        "accessToken": { "type": "string", "description": "Meta System User Permanent Access Token." },
        "verifyToken": { "type": "string", "description": "Meta Webhook Verification Token chosen by admin." },
        "updatedAt": { "type": "number", "description": "Epoch timestamp of last update." }
      },
      "required": ["phoneNumberId", "businessAccountId", "accessToken", "verifyToken", "updatedAt"]
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Represents a browser's W3C standard PushSubscription for Web Push notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier, usually hashed subscription endpoint." },
        "endpoint": { "type": "string", "description": "The push service subscription endpoint URL." },
        "keys": { "type": "object", "description": "The client encryption keys (p256dh and auth)." },
        "userId": { "type": "string", "description": "The associated user ID, or null/guest if logged out." },
        "createdAt": { "type": "number", "description": "The epoch timestamp when this device subscribed." }
      },
      "required": ["id", "endpoint", "keys", "createdAt"]
    },
    "StaffDailyReport": {
      "title": "StaffDailyReport",
      "description": "Daily activity performance report submitted by recruiters and staff.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique report identifier." },
        "uid": { "type": "string", "description": "UID of the staff who submitted the report." },
        "staffName": { "type": "string", "description": "Name of the staff." },
        "date": { "type": "string", "description": "YYYY-MM-DD date representation." },
        "timestamp": { "type": "number", "description": "Submission timestamp." },
        "newReachOuts": { "type": "number", "description": "Number of new reach-outs." },
        "resumptions": { "type": "number", "description": "Number of resumptions." },
        "cvsCollected": { "type": "number", "description": "Number of CVs collected." },
        "candidatesRegistered": { "type": "number", "description": "Number of candidates registered." },
        "addressesGiven": { "type": "number", "description": "Number of addresses referred/given." },
        "commissionRetrieved": { "type": "string", "description": "Commission details retrieved." },
        "flyersMade": { "type": "number", "description": "Number of flyers made." },
        "videosMade": { "type": "number", "description": "Number of videos made." },
        "jobsGotten": { "type": "number", "description": "Number of jobs gotten." },
        "newJobsGottenClientRelations": { "type": "string", "description": "Details of new jobs from Client Relations." },
        "challenges": { "type": "string", "description": "Challenges encountered." },
        "plansTomorrow": { "type": "string", "description": "Plans for tomorrow." },
        "chatsClearedConfirmed": { "type": "boolean", "description": "Whether the staff confirmed chats were cleared." },
        "chatsClearedProofUrl": { "type": "string", "description": "Image proof of chats cleared." },
        "targetReachOutsMet": { "type": "boolean", "description": "If reach-outs target >= 20 was met." },
        "targetAddressesMet": { "type": "boolean", "description": "If addresses referred target >= 4 was met." },
        "targetOnTimeMet": { "type": "boolean", "description": "If submitted before 9:00 PM local." }
      },
      "required": ["id", "uid", "staffName", "date", "timestamp", "newReachOuts", "resumptions", "cvsCollected", "candidatesRegistered", "addressesGiven", "challenges", "plansTomorrow", "chatsClearedConfirmed", "targetReachOutsMet", "targetAddressesMet", "targetOnTimeMet"]
    },
    "CustomerContact": {
      "title": "CustomerContact",
      "description": "Customer contact record extracted from conversations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique contact ID." },
        "customerPhone": { "type": "string", "description": "Customer phone number." },
        "name": { "type": "string", "description": "Contact display name." },
        "lastJobTitle": { "type": "string", "description": "Last inquired job title." },
        "firstSeenAt": { "type": "number", "description": "First interaction epoch timestamp." },
        "lastSeenAt": { "type": "number", "description": "Last interaction epoch timestamp." },
        "chatCount": { "type": "number", "description": "Total count of chats." }
      },
      "required": ["id", "customerPhone", "firstSeenAt", "lastSeenAt", "chatCount"]
    },
    "DailyStat": {
      "title": "DailyStat",
      "description": "Daily aggregated platform analytics.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Date formatted ID." },
        "date": { "type": "string", "description": "YYYY-MM-DD date." },
        "impressions": { "type": "number", "description": "Total impressions." },
        "sent": { "type": "number", "description": "Total inquiries initiated." },
        "claimed": { "type": "number", "description": "Total chats claimed." },
        "finished": { "type": "number", "description": "Total chats resolved." },
        "abandoned": { "type": "number", "description": "Total chats abandoned." },
        "timestamp": { "type": "number", "description": "Timestamp." }
      },
      "required": ["id", "date", "impressions", "sent", "claimed", "finished", "abandoned", "timestamp"]
    },
    "SystemNotification": {
      "title": "SystemNotification",
      "description": "In-app and staff notification record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique notification ID." },
        "type": { "type": "string", "description": "Notification category identifier." },
        "title": { "type": "string", "description": "Notification header." },
        "message": { "type": "string", "description": "Notification content body." },
        "timestamp": { "type": "number", "description": "Epoch creation timestamp." },
        "isRead": { "type": "boolean", "description": "Read acknowledgement flag." },
        "seekerUid": { "type": "string", "description": "Target seeker UID if targeted." },
        "staffUid": { "type": "string", "description": "Target staff UID if targeted." }
      },
      "required": ["id", "type", "title", "message", "timestamp", "isRead"]
    },
    "ConnectionDiagnostic": {
      "title": "ConnectionDiagnostic",
      "description": "Diagnostic and connectivity heartbeat records.",
      "type": "object",
      "properties": {
        "status": { "type": "string", "description": "Diagnostic status." },
        "configured": { "type": "boolean", "description": "Configuration verification state." },
        "last_checked": { "type": "string", "description": "ISO timestamp string." },
        "uid": { "type": "string", "description": "UID of executor." },
        "email": { "type": "string", "description": "Email of executor." }
      },
      "required": ["status", "configured"]
    }
  },
  "firestore": {
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Global collection containing all job listings."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection tracking user profiles, identities, and permissions."
    },
    "/conversations/{chatId}": {
      "schema": "Conversation",
      "description": "Global durable storage for all messaging conversations, messages, and typing states."
    },
    "/staff_statuses/{uid}": {
      "schema": "StaffStatus",
      "description": "Real-time presence and online/offline status for recruiters."
    },
    "/settings/{settingId}": {
      "schema": "WhatsAppConfig",
      "description": "System configuration documents restricted to administrator access."
    },
    "/push_subscriptions/{subscriptionId}": {
      "schema": "PushSubscription",
      "description": "Collection of active browser web push subscriptions for triggering system notifications."
    },
    "/daily_reports/{reportId}": {
      "schema": "StaffDailyReport",
      "description": "Recruiter and staff daily activity reports tracked by administrators."
    },
    "/contacts/{contactId}": {
      "schema": "CustomerContact",
      "description": "Customer contacts extracted from inquiries."
    },
    "/daily_stats/{statId}": {
      "schema": "DailyStat",
      "description": "Daily metrics and performance statistics."
    },
    "/system_notifications/{notificationId}": {
      "schema": "SystemNotification",
      "description": "In-app and push notification log."
    },
    "/connection_diagnostics/{docId}": {
      "schema": "ConnectionDiagnostic",
      "description": "Diagnostic connectivity records."
    },
    "/connection_tests/{testId}": {
      "schema": "ConnectionDiagnostic",
      "description": "Temporary ping verification test records."
    }
  }
}
